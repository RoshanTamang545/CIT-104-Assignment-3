│     START     │
                 └───────┬───────┘
                         │
                         ▼
              ┌─────────────────────┐
              │ Input number        │
              │ (2 through 100)     │
              └──────────┬──────────┘
                         │
                         ▼
              ┌─────────────────────┐
              │ original_number =   │
              │ number              │
              │ factors = []        │
              │ factor = 2          │
              └──────────┬──────────┘
                         │
                         ▼
                  ┌──────────────┐
             ┌───▶│ number > 1 ? │
             │    └──────┬───────┘
             │           │
             │      YES  │
             │           ▼
             │    ┌──────────────────┐
             │    │ number % factor  │
             │    │      == 0 ?      │
             │    └───────┬──────────┘
             │            │
          YES│            │NO
             │            │
             ▼            ▼
    ┌────────────────┐  ┌───────────────┐
    │ Add factor to  │  │ factor =      │
    │ factors list   │  │ factor + 1    │
    └───────┬────────┘  └───────┬───────┘
            │                   │
            ▼                   │
    ┌────────────────┐          │
    │ number =       │          │
    │ number //      │          │
    │ factor         │          │
    └───────┬────────┘          │
            │                   │
            └─────────┬─────────┘
                      │
                      └───────────────┐
                                      │
                                      ▼
                              number > 1 ?
                                      │
                                      │ NO
                                      ▼
                       ┌────────────────────────┐
                       │ len(factors) == 1 AND │
                       │ factors[0] ==         │
                       │ original_number ?     │
                       └───────────┬────────────┘
                                   │
                         YES       │       NO
                          │        │        │
                          ▼        │        ▼
                  ┌────────────┐   │  ┌──────────────┐
                  │ Print      │   │  │ Print factors│
                  │ "PRIME"    │   │  │ separated by │
                  └─────┬──────┘   │  │ spaces       │
                        │          │  └──────┬───────┘
                        │          │         │
                        └──────────┴─────────┘
                                   │
                                   ▼
                              ┌───────────┐
                              │    END    │
                              └───────────┘
